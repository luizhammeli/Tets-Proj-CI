default_platform(:ios)

lane :ci_lint do
  swiftlint(
    mode: :lint,        # ou :fix
    strict: true        # falha o build se houver warning/error
  )
end

desc "Run Scheme Tets-Proj-CI"
lane :ci_iOS do
  scan(
      clean: true,
      scheme: "Tets-Proj-CI",
      sdk: "iphonesimulator",
      code_coverage: true,
      result_bundle: true
  )

  derived_data = lane_context[SharedValues::SCAN_DERIVED_DATA_PATH]
  sh("ls -R #{derived_data}/Build/ProfileData || true")
  sh("ls -R #{derived_data}/Build/Products || true")
  
  profdata = Dir["#{derived_data}/Build/ProfileData/*/*.profdata"].first
  UI.user_error!("profdata not found") unless profdata

 app_bundle = Dir["#{derived_data}/Build/Products/**/*.app"].first
 UI.user_error!("app bundle not found") unless app_bundle

app_binary = File.join(
  app_bundle,
  File.basename(app_bundle, ".app")
)

UI.user_error!("app binary not found") unless File.exist?(app_binary)
output_path = File.join(Dir.pwd, "coverage.lcov")
sh("xcrun llvm-cov export -format=lcov -instr-profile '#{profdata}' '#{app_binary}' > '#{output_path}'")
end
